# Chuỗi kết nối MongoDB Atlas (để lưu dữ liệu vĩnh viễn trên Render)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/fido2_db?retryWrites=true&w=majority

# Cấu hình FIDO2 (trên Render: đặt RP_ID là domain không có https, ORIGIN có https)
RP_ID=localhost
ORIGIN=http://localhost:3000

# Tên tài khoản Admin mặc định (mặc định: admin)
ADMIN_USERNAME=admin

# Mã bảo vệ cài đặt tài khoản Admin lần đầu (BẮT BUỘC TRÊN PRODUCTION - sinh ngẫu nhiên: openssl rand -hex 16)
ADMIN_SETUP_TOKEN=thay-bang-ma-cai-dat-admin-ngau-nhien

# Khóa bí mật ký Cookie phiên Session (BẮT BUỘC TRÊN PRODUCTION - sinh ngẫu nhiên: openssl rand -hex 32)
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-do-openssl-rand-hex-32-tao-ra

# Môi trường chạy: development hoặc production
NODE_ENV=development

